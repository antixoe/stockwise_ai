APP_NAME="StockWise AI"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://stockwise.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=private-mysql-host
DB_PORT=3306
DB_DATABASE=stockwise
DB_USERNAME=stockwise_app
DB_PASSWORD=SET_IN_SECRET_MANAGER
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=stockwise-production

AI_FORECAST_URL=https://private-ai-host/v1/forecast
AI_EXPLAIN_URL=https://private-ai-host/v1/explain
AI_SERVICE_SECRET=SET_IN_SECRET_MANAGER
AI_SERVICE_TIMEOUT=30
AI_SERVICE_RETRY_TIMES=2
AI_HISTORY_DAYS=365

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=private-smtp-host
MAIL_PORT=587
MAIL_USERNAME=SET_IN_SECRET_MANAGER
MAIL_PASSWORD=SET_IN_SECRET_MANAGER
MAIL_FROM_ADDRESS=no-reply@stockwise.example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
